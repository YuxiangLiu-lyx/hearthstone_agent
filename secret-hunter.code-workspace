{
  "folders": [
    {
      "name": "Policy",
      "path": "secret-hunter-program"
    },
    {
      "name": "Research",
      "path": "development/secret_hunter_tactics"
    },
    {
      "name": "Teacher tests",
      "path": "development/teacher_eval"
    },
    {
      "name": "Teacher results",
      "path": "experiments/teacher-submission-1"
    },
    {
      "name": "Reports",
      "path": "docs"
    },
    {
      "name": "Releases",
      "path": "dist"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:Policy}/../.venv/bin/python",
    "terminal.integrated.cwd": "${workspaceFolder:Policy}/..",
    "python.analysis.exclude": [
      "**/.git",
      "**/.venv",
      "**/node_modules",
      "**/__pycache__",
      "**/candidates",
      "**/release*",
      "**/package*",
      "**/previous-champion",
      "**/scratch"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "files.watcherExclude": {
      "**/.venv/**": true,
      "**/node_modules/**": true,
      "**/__pycache__/**": true,
      "**/candidates/**": true,
      "**/release*/**": true,
      "**/package*/**": true,
      "**/previous-champion/**": true,
      "**/scratch/**": true,
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true
    },
    "search.exclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      "**/node_modules/**": true,
      "**/__pycache__/**": true,
      "**/candidates/**": true,
      "**/release*/**": true,
      "**/package*/**": true,
      "**/previous-champion/**": true,
      "**/scratch/**": true
    },
    "search.followSymlinks": false,
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true
    }
  }
}
